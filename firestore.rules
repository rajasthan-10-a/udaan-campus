rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function getRoleFromClaims() {
      return request.auth.token.role != null ? request.auth.token.role : '';
    }

    function isSuperManager() {
      return getRoleFromClaims() == 'super_manager';
    }

    function isManager() {
      return isSuperManager() || getRoleFromClaims() == 'manager';
    }

    function isTeacher() {
      return isSuperManager() || isManager() || getRoleFromClaims() == 'teacher';
    }

    function isLinkedParent(studentId) {
      return getRoleFromClaims() == 'parent' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedChildren != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.linkedChildren.hasAny([studentId]);
    }

    // Users collection: only backend/admin (super_manager) may change roles and sensitive fields
    match /users/{userId} {
      allow read: if isSignedIn() && (
        // users can read their own profile
        request.auth.uid == userId ||
        // managers and above can read other profiles
        isManager()
      );

      allow create: if isSignedIn() && (
        isManager() ||
        (request.auth.uid == userId &&
         request.resource.data.uid == userId &&
         request.resource.data.role == 'student' &&
         request.resource.data.normalizedRole == 'student')
      );

      allow update: if isSignedIn() && (
        // Prevent client-side role escalation: only super_manager (trusted) can change 'role' or 'normalizedRole'
        (isSuperManager()) ||
        // Protect the immutable primary owner UID: only super_manager or backend service may modify owner account
        (
          // allow user to update their own non-role fields
          request.auth.uid == userId
          && !(request.resource.data.keys().hasAny(['role','normalizedRole']) && request.resource.data.diff(resource.data).affectedKeys().hasAny(['role','normalizedRole']))
          // additionally, if this user is the configured primary owner, disallow self-update of owner-sensitive fields
          && !(userId == get(/databases/$(database)/documents/config/primary_owner).data.uid && request.resource.data.diff(resource.data).affectedKeys().size() > 0)
        )
      );

      allow delete: if isSignedIn() && isSuperManager();
    }

    // Attendance: managers and teachers for assigned classes, students/parents for own data
    match /attendance/{docId} {
      allow read: if isSignedIn() && (
        isSuperManager() || isManager() || isTeacher() || request.auth.uid == resource.data.markedBy || request.auth.uid == resource.data.studentId
      );
      allow write: if isSignedIn() && (
        isSuperManager() || isManager() || isTeacher()
      );
    }

    // Homework: published visible to students/parents; creation/moderation by teacher/manager/super
    match /homework/{homeworkId} {
      allow read: if isSignedIn() && (
        resource.data.status == 'PUBLISHED' || isSuperManager() || isManager() || isTeacher() || request.auth.uid == resource.data.teacherId
      );
      allow create: if isSignedIn() && (isTeacher() || isManager() || isSuperManager());
      allow update: if isSignedIn() && (isSuperManager() || isManager() || isTeacher());
      allow delete: if isSignedIn() && isSuperManager();
    }

    // Student and class data used by attendance and marksheet screens.
    match /students/{studentId} {
      allow read: if isSignedIn() && (
        isSuperManager() || isManager() || isTeacher() ||
        isLinkedParent(studentId) ||
        request.auth.uid == resource.data.uid ||
        request.auth.token.email == resource.data.email
      );
      allow create, update: if isSignedIn() && (isSuperManager() || isManager() || isTeacher());
      allow delete: if isSignedIn() && isSuperManager();
    }

    match /classes/{classId} {
      allow read: if isSignedIn() && (isSuperManager() || isManager() || isTeacher());
      allow write: if isSignedIn() && (isSuperManager() || isManager());
    }

    match /tests/{testId} {
      allow read: if isSignedIn() && (isSuperManager() || isManager() || isTeacher());
      allow write: if isSignedIn() && (isSuperManager() || isManager() || isTeacher());
    }

    match /test_results/{resultId} {
      allow read: if isSignedIn() && (
        isSuperManager() || isManager() || isTeacher() ||
        request.auth.uid == resource.data.studentId
      );
      allow create, update: if isSignedIn() && isSuperManager();
      allow delete: if isSignedIn() && isSuperManager();
    }

    match /notices/{noticeId} {
      allow read: if isSignedIn() && resource.data.status == 'PUBLISHED';
      allow write: if isSignedIn() && (isSuperManager() || isManager() || isTeacher());
    }

    match /school_timings/{timingId} {
      allow read: if isSignedIn() && resource.data.status == 'PUBLISHED';
      allow write: if isSignedIn() && (isSuperManager() || isManager());
    }

    match /student_qr_tokens/{token} {
      allow read: if isSignedIn() && (
        isSuperManager() || isManager() || isTeacher() ||
        request.auth.uid == get(/databases/$(database)/documents/students/$(resource.data.studentId)).data.uid ||
        isLinkedParent(resource.data.studentId)
      );
      allow create, update, delete: if isSignedIn() && (isSuperManager() || isManager());
    }

    match /exam_papers/{paperId} {
      allow read: if isSignedIn() && (isSuperManager() || isManager() || isTeacher());
      allow create: if isSignedIn() && (isSuperManager() || isTeacher());
      allow update, delete: if isSignedIn() && (isSuperManager() || resource.data.uploadedBy == request.auth.uid);
    }

    match /courses/{courseId} {
      allow read: if isSignedIn() &&
        (resource.data.status == 'PUBLISHED' || isManager());
      allow create: if isSignedIn() && isManager();
      allow update: if isSignedIn() &&
        (isSuperManager() || resource.data.createdBy == request.auth.uid);
      allow delete: if isSignedIn() && isSuperManager();
    }

    match /course_resources/{resourceId} {
      allow read: if isSignedIn() &&
        (resource.data.status == 'PUBLISHED' || isManager() || isTeacher());
      allow create: if isSignedIn() && isManager();
      allow update: if isSignedIn() &&
        (isSuperManager() || resource.data.createdBy == request.auth.uid);
      allow delete: if isSignedIn() && isSuperManager();
    }

    match /mock_tests/{testId} {
      allow read: if isSignedIn() &&
        (resource.data.status == 'PUBLISHED' || isManager() || isTeacher());
      allow create: if isSignedIn() && isManager();
      allow update: if isSignedIn() &&
        (isSuperManager() || resource.data.createdBy == request.auth.uid);
      allow delete: if isSignedIn() && isSuperManager();
    }

    // Tests/results, calling_logs, audit_logs etc.
    match /{document=**} {
      allow read: if false;
      allow write: if false;
    }

    // Audit logs should be write-only by backend: clients cannot write or delete
    match /audit_logs/{auditId} {
      allow read: if isSignedIn() && isSuperManager();
      allow create: if request.auth.token.admin == true; // only trusted backend service accounts
      allow update, delete: if false;
    }
  }
}
